{
  "schema_version": 3,
  "pipeline_version": "formosan-mt-corpus-v3",
  "formosanbank": {
    "org": "FormosanBank",
    "repo": "FormosanBank",
    "qc_revision": "acc3ec9f3137a59b9661e446a750ee1606720394"
  },
  "cleaning": {
    "profile": "formosan-mt-v3.4",
    "unicode_normalization": "NFC",
    "require_standard_form": true,
    "preserve_structural_row_type": true,
    "preserve_xml_units": true,
    "skip_mt_ineligible_units_during_extraction": true,
    "log_validator_findings_without_aborting": true,
    "complete_missing_dialect_with_pinned_qc": true,
    "remove_zero_width_characters": true,
    "trim_form_boundary_whitespace": true,
    "remove_untyped_punctuation_only": true,
    "disambiguate_unreferenced_duplicate_ids": true
  },
  "mt_standardization": {
    "profile": "config/mt_standardization.json",
    "profile_id": "formosan-mt-standard-v3",
    "namespace": "formosan-mt",
    "source_xml_immutable": true,
    "ambiguous_eval": false,
    "unclear_eval": false,
    "formosan_sentence_alias": "formosan_mt_standard"
  },
  "pivot": {
    "require_complete": true,
    "synthetic_eval": true,
    "eligible_row_types": ["sentence"],
    "require_mt_eval_eligible": true,
    "exclude_lexical_sources": true,
    "min_formosan_tokens": 4,
    "min_source_units": 4
  },
  "splits": {
    "seed": 42,
    "train_ratio": 0.85,
    "validate_ratio": 0.05,
    "test_ratio": 0.10,
    "min_test_rows": 0,
    "min_validate_rows": 0,
    "character_ngram_jaccard_threshold": 0.82,
    "source_ratio_tolerance": 0.02,
    "min_formosan_tokens": 2,
    "min_target_tokens": 2,
    "min_combined_tokens": 6,
    "min_punctuated_combined_tokens": 5,
    "lexical_eval": false,
    "synthetic_eval": true,
    "synthetic_eval_policy": "human_preferred_source_stratified_fallback",
    "ratio_basis": "all_deduplicated_pairs_by_language_and_source_corpus",
    "headline_tier": "in_domain_hard"
  },
  "exposure_audit": {
    "tool": "tame-mt",
    "version": "0.2.2",
    "retrieval": "exact",
    "normalization": "NFKC case-insensitive",
    "high_threshold": 0.95,
    "max_high_exposure_rate": 0.0
  }
}
